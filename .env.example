# MsSqlToPg Environment Variables
# Copy this file to .env and fill in your local values
# NEVER commit .env file to version control

# Source Database - SQL Server
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=SourceDatabase
MSSQL_USER=sa
MSSQL_PASSWORD=YourPassword123!
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERTIFICATE=true

# Target Database - PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=target_database
PG_USER=postgres
PG_PASSWORD=postgres_password
PG_SSL_MODE=prefer

# Migration Settings
MIGRATION__BATCH_SIZE=1000
MIGRATION__PARALLEL_THREADS=4
MIGRATION__VALIDATE_AFTER_MIGRATION=true
MIGRATION__SKIP_DATA=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=migration.log

# Advanced Options
MIGRATION__ROW_COUNT_CHECK=true
MIGRATION__DATA_INTEGRITY_CHECK=true
MIGRATION__GENERATE_REPORT=true
